spacing:.06em;color:var(--cyan);padding-top:3px}\n  .faq-q{margin:0 0 8px;font-size:17px;font-weight:700;color:var(--slate-deep);line-height:1.5}\n  .faq-a{margin:0;font-size:15px;max-width:54em;color:var(--slate)}\n  .faq-a + .faq-a{margin-top:10px;color:var(--slate-soft);font-size:14px}\n\n  /* 结尾说明 */\n  .closing{border-bottom:none;padding-bottom:80px}\n  .closing-box{background:var(--white);border:1px solid var(--line);border-top:4px solid var(--slate);padding:32px 30px}\n  .closing-box h2{font-size:22px;margin-bottom:14px}\n  .closing-box p{margin:0 0 14px;max-width:52em;font-size:15px}\n  .closing-box p:last-child{margin-bottom:0}\n\n  footer{background:var(--slate-deep);color:#c3cbd2;font-size:13px}\n  footer .wrap{padding:26px 24px 30px;display:flex;flex-wrap:wrap;gap:8px 24px;align-items:baseline}\n  footer a{color:#e3ecee}\n  footer .sep{color:#566270}\n\n  @media (max-width:820px){\n    .hero-inner{grid-template-columns:1fr;gap:32px;padding:48px 0 56px}\n    .cols{grid-template-columns:1fr;gap:28px}\n    .client-grid{grid-template-columns:1fr}\n    section{padding:48px 0}\n    .plan{padding:22px 20px 24px}\n    .plan-index{font-size:86px;bottom:-20px}\n    .step{grid-template-columns:1fr;gap:8px;padding:22px 0}\n    .step-no{font-size:24px}\n    .faq-item{grid-template-columns:1fr;gap:4px}\n    .closing-box{padding:24px 20px}\n  }\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumbs\" aria-label=\"面包屑\">\n      跃迁加速 <span>/</span> 产品说明 <span>/</span> 套餐与使用\n    </nav>\n    <nav class=\"dir\" aria-label=\"页面目录\">\n      <span class=\"dir-label\">目录</span>\n      <a href=\"#plans\">套餐</a>\n      <a href=\"#howto\">使用说明</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n      <a href=\"#notes\">说明</a>\n    </nav>\n  </div>\n</div>\n\n<main>\n\n  <header class=\"hero\">\n    <div class=\"wrap hero-inner\">\n      <div>\n        <p class=\"hero-kicker\">跃迁加速 · 页面导读</p>\n        <h1>跃迁加速 · 先把<em>套餐差异</em>看清楚，再决定要不要往下走。</h1>\n        <p class=\"hero-lede\">这一页不讲玄乎的形容词。它只回答几个具体问题：三档套餐分别给多少流量、允许几台设备、按年付是多少钱，以及你拿到账号之后第一步该做什么。</p>\n        <p class=\"hero-note\">如果你只想快速定位，用上方的目录跳到对应区块即可；如果还在犹豫，建议从套餐区块读起，再看使用说明。</p>\n      </div>\n      <div class=\"hero-side\">\n        <div class=\"side-panel\">\n          <dl>\n            <dt>页面性质</dt>\n            <dd>产品说明与信息核对</dd>\n            <dt>包含内容</dt>\n            <dd>套餐、使用步骤、客户端、常见问题</dd>\n            <dt>阅读顺序</dt>\n            <dd>套餐 → 使用说明 → 常见问题</dd>\n            <dt>价格口径</dt>\n            <dd>月付与年付并列标注</dd>\n          </dl>\n          <p>本页内容以站内公开的套餐信息为准。未在本页写明的服务能力，不作为承诺。</p>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <section id=\"plans\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">01</span>\n        <h2>套餐逐条展开</h2>\n      </div>\n      <p class=\"sec-sub\">三档套餐按容量和设备数递进。先看每月流量，再看同时在线设备数，最后看是否需要用专线相关的条目。</p>\n\n      <div class=\"plan-list\">\n\n        <article class=\"plan\">\n          <span class=\"plan-index\">01</span>\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">基础版</h3>\n            <span class=\"plan-price\">¥15<small>/月</small></span>\n            <span class=\"plan-annual\">按年付 ¥150/年</span>\n          </div>\n          <ul>\n            <li>每月 100GB 流量额度</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>基础流媒体解锁</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-foot\">适合单人日常使用、设备不多、流量需求不大的情况。价格与容量以本页所列内容为准。</p>\n        </article>\n\n        <article class=\"plan\">\n          <span class=\"plan-index\">02</span>\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">旗舰版</h3>\n            <span class=\"plan-tag\">推荐</span>\n            <span class=\"plan-price\">¥35<small>/月</small></span>\n            <span class=\"plan-annual\">按年付 ¥350/年</span>\n          </div>\n          <ul>\n            <li>每月 300GB 流量额度</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线，针对游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-foot\">在流量、设备数和线路类型上同时上了一个台阶，适合手机、平板、电脑混用的用户。</p>\n        </article>\n\n        <article class=\"plan\">\n          <span class=\"plan-index\">03</span>\n          <div class=\"plan-head\">\n            <h3 class=\"plan-name\">团队版</h3>\n            <span class=\"plan-price\">¥85<small>/月</small></span>\n            <span class=\"plan-annual\">按年付 ¥850/年</span>\n          </div>\n          <ul>\n            <li>每月 1000GB 流量额度</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-foot\">面向多人或团队场景，设备数与流量额度都按整组来配置；定制路由与客户经理服务需在开通前确认具体内容。</p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">02</span>\n        <h2>拿到账号后怎么做</h2>\n      </div>\n      <p class=\"sec-sub\">下面四步是最小可用路径。每一步都只做一件事，做完再进入下一步，避免在中间环节反复试错。</p>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-no\">1</div>\n          <div>\n            <h3>先确认你买的是哪一档</h3>\n            <p>对照上面的套餐条目，核对流量额度、同时在线设备数和线路类型。三档之间的差异集中在这三项上，先把它们记清楚，后面下载客户端和配置时不容易选错。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-no\">2</div>\n          <div>\n            <h3>确认设备数量够不够用</h3>\n            <p>基础版 3 台、旗舰版 5 台、团队版 20 台，指的是同时在线数，不是累计添加的设备数。如果你经常在手机和电脑之间来回切换，先按常用设备实际数量来选。</p>\n            <p>设备数不足时，通常表现为后登录的设备把先前的设备挤下线，而不是速度变慢。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-no\">3</div>\n          <div>\n            <h3>在客户端区块选择对应平台</h3>\n            <p>客户端区块按操作系统分列。先看你的系统在大类里属于哪一列，再按该列的说明完成安装与登录。不同平台的入口名称可能略有差异，以客户端内实际显示为准。</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-no\">4</div>\n          <div>\n            <h3>遇到问题先看常见问题</h3>\n            <p>常见问题按编号排列，覆盖套餐选择、设备数、按年付、线路差异等最常见的几类疑问。若你的问题不在其中，可提交工单，旗舰版与团队版在工单优先级上有区别。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">03</span>\n        <h2>客户端按平台分开看</h2>\n      </div>\n      <p class=\"sec-sub\">本页不提供直接下载链接。各平台的具体入口与安装方式，请以你所购套餐对应的客户端说明为准；未确认的地址此处留空，不作为可点击链接呈现。</p>\n\n      <div class=\"client-grid\">\n        <article class=\"client\">\n          <span class=\"client-index\">A</span>\n          <h3>桌面端</h3>\n          <p><strong>适用平台</strong>：Windows、macOS</p>\n          <p>适合固定在办公桌或家里使用，设备数占用为 1 台。</p>\n          <p>安装后先登录账号，再选择线路；切换线路不需要重新登录。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"client-index\">B</span>\n          <h3>移动端</h3>\n          <p><strong>适用平台</strong>：iOS、Android</p>\n          <p>手机与平板分别计为 1 台设备，注意不要超出套餐上限。</p>\n          <p>移动网络与 Wi-Fi 之间切换时，通常需要重新连接一次。</p>\n        </article>\n        <article class=\"client\">\n          <span class=\"client-index\">C</span>\n          <h3>路由器与其他设备</h3>\n          <p><strong>适用平台</strong>：视设备能力而定</p>\n          <p>接入路由器后，下游设备可能共享同一份连接，实际计数方式以客户端显示为准。</p>\n          <p>团队版的定制路由需在开通前与客户经理确认范围。</p>\n        </article>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"wrap\">\n      <div class=\"sec-head\">\n        <span class=\"sec-num\">04</span>\n        <h2>常见问题</h2>\n      </div>\n      <p class=\"sec-sub\">按编号顺序提问。每一问只对应一个答案，避免一句话里塞多个结论。</p>\n\n      <div class=\"faq-group\">\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">01</div>\n          <div>\n            <h3 class=\"faq-q\">基础版和旗舰版只差流量吗？</h3>\n            <p class=\"faq-a\">不完全是。三个差异同时存在：流量从 100GB 提到 300GB；同时在线设备数从 3 台提到 5 台；线路方面旗舰版包含 IPLC 专线并针对游戏加速做过优化，基础版是普通线路节点池。如果你只用一台设备、也不在意线路类型，基础版就够了。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">02</div>\n          <div>\n            <h3 class=\"faq-q\">按年付是自动续费吗？</h3>\n            <p class=\"faq-a\">本页只列出价格口径：基础版 ¥150/年、旗舰版 ¥350/年、团队版 ¥850/年。是否自动续费、如何取消，属于订阅设置层面的事，请以开通时页面上的说明为准，本页不作推定。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">03</div>\n          <div>\n            <h3 class=\"faq-q\">同时在线的设备数怎么算？</h3>\n            <p class=\"faq-a\">按同一时间处于连接状态的设备计算。基础版 3 台、旗舰版 5 台、团队版 20 台。关掉某个设备上的客户端后，该设备通常不再占用名额，具体以客户端内的显示为准。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">04</div>\n          <div>\n            <h3 class=\"faq-q\">团队版一定需要定制路由吗？</h3>\n            <p class=\"faq-a\">不一定。团队版包含 VIP 专属高带宽节点和 20 台设备上限，这些不需要额外配置就能使用。支持企业定制路由和专属客户经理服务属于可选能力，涉及具体网络结构，需要在开通前确认范围。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">05</div>\n          <div>\n            <h3 class=\"faq-q\">用下来觉得不合适，可以换套餐吗？</h3>\n            <p class=\"faq-a\">三档套餐之间是递进关系，向上调整通常比向下调整简单。本页不写明具体变更规则与结算方式，因为这类信息需要以实际账户状态为准，请通过工单或客户经理确认后再操作。</p>\n          </div>\n        </article>\n\n        <article class=\"faq-item\">\n          <div class=\"faq-no\">06</div>\n          <div>\n            <h3 class=\"faq-q\">为什么不直接给出下载地址？</h3>\n            <p class=\"faq-a\">本页只承担信息说明的角色。未经过确认的下载地址不做展示，也不作为可点击链接出现。请以你所购套餐对应的客户端说明为入口，避免从来源不明的地址安装。</p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <section id=\"notes\" class=\"closing\">\n    <div class=\"wrap\">\n      <div class=\"closing-box\">\n        <h2>最后再确认一遍</h2>\n        <p>套餐部分写了价格、流量、设备数和线路类型四项；使用说明部分写了拿到账号后的四个步骤；客户端部分按桌面端、移动端、路由器与其他设备分开说明；常见问题部分回答了六个具体疑问。</p>\n        <p>凡是本页没有写到的，都不作为跃迁加速的服务承诺。需要确认的事项，请在上方目录回到对应区块逐条核对，或提交工单说明你的具体情况。</p>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <span>跃迁加速</span>\n    <span class=\"sep\">/</span>\n    <span>套餐与使用说明</span>\n    <span class=\"sep\">/</span>\n    <a href=\"#plans\">返回套餐</a>\n    <span class=\"sep\">/</span>\n    <a href=\"#faq\">返回常见问题</a>\n  </div>\n</footer>",
